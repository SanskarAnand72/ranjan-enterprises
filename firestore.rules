rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Users: authenticated user can read own data, admin full access
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    // Products: public read published, admin full access
    match /products/{productId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    // Categories: public read, admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Enquiries: public create, admin read/update/delete
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Settings & Website Settings: public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /website_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery: public read, admin write
    match /gallery/{albumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials, Services, Homepage content
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /homepage_content/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
